{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purchase-research-agent.local/contracts/collector/v1-29cm/29cm-crawl-item.schema.json",
  "title": "29CM 크롤러 상품 항목 v1-29cm",
  "description": "purchase-research-agent의 Cm29Crawler(app/crawlers/cm29/crawler.py)가 반환하는 상품 dict 1건의 스키마. display-bff-api.29cm.co.kr 내부 JSON API에서 직접 수집하므로 HTML 파싱 없이 구조화된 데이터를 얻는다. 카테고리 크롤링은 현재 미지원 — 키워드 검색(pageType=SRP)만 가능.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_product_id",
    "title",
    "brand",
    "price",
    "price_original",
    "discount_percent",
    "image_url",
    "color",
    "style_code",
    "link",
    "site"
  ],
  "properties": {
    "site": {
      "const": "29cm"
    },
    "source_product_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "29CM itemId(숫자)를 str()로 변환한 값."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "itemInfo.productName"
    },
    "brand": {
      "type": "string",
      "maxLength": 100,
      "description": "itemInfo.brandName. API가 null을 반환하면 빈 문자열로 저장한다."
    },
    "price": {
      "$ref": "#/$defs/priceString",
      "description": "itemInfo.sellPrice → '{n,nnn}원' 형태로 변환."
    },
    "price_original": {
      "$ref": "#/$defs/priceString",
      "description": "itemInfo.originalPrice → '{n,nnn}원' 형태로 변환. originalPrice가 null이면 빈 문자열."
    },
    "discount_percent": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "itemInfo.saleRate를 round()한 정수. saleRate가 null이면 null."
    },
    "image_url": {
      "type": "string",
      "maxLength": 500,
      "description": "itemInfo.thumbnailUrl. null이면 빈 문자열."
    },
    "color": {
      "type": "string",
      "maxLength": 0,
      "description": "29CM 목록 API는 카드 단위 색상 정보를 제공하지 않는다 — 항상 빈 문자열."
    },
    "style_code": {
      "type": "string",
      "maxLength": 0,
      "description": "29CM 목록 API는 style code를 제공하지 않는다 — 항상 빈 문자열."
    },
    "link": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^https://www\\.29cm\\.co\\.kr/.*$",
      "description": "itemUrl.webLink. 29CM 상품 상세 페이지 URL."
    }
  },
  "$defs": {
    "priceString": {
      "type": "string",
      "pattern": "^$|^[0-9,]+원$",
      "description": "빈 문자열 또는 '89,000원' 형태."
    }
  }
}
