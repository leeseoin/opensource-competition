# Python Backend를 Docker 밖에서 직접 실행할 때 사용할 예제다.
# 루트 `.env`의 DB 이름·사용자·비밀번호·포트를 변경했다면 이 URL도 같은 값으로 맞춘다.
PURCHASE_RESEARCH_DATABASE_URL=postgresql+psycopg://purchase_research:purchase_research@127.0.0.1:35432/purchase_research
