# AgentPay Guard API 서버 주소
GUARD_API_BASE_URL=http://localhost:8080

# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-api03-...

# 사용할 Claude 모델
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PREMIUM=claude-sonnet-4-6

# Agent 서버 설정
AGENT_SERVER_HOST=0.0.0.0
AGENT_SERVER_PORT=8001

# 기본 Agent ID (Guard에 등록된 agent UUID)
DEFAULT_AGENT_ID=agent-sample-001

# API Key 인증 (비워두면 인증 없이 열어둠, PoC 기본값)
AGENT_API_KEY=
