# Spring Boot API Server
GUARD_API_BASE_URL=http://localhost:8080

# Anthropic Claude AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PREMIUM=claude-sonnet-5

# Agent Server settings
AGENT_SERVER_PORT=8001
AGENT_SERVER_HOST=0.0.0.0

# Default agent ID used when calling Guard API
DEFAULT_AGENT_ID=agent-sample-001

# Optional: set to require an X-API-Key header on incoming requests. Leave empty to disable.
AGENT_API_KEY=
