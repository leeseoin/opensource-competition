# 사용 방법:
# 1. 저장소 루트에서 `cp .env.example .env`를 실행한다.
# 2. 생성된 `.env`의 값을 로컬 환경에 맞게 수정한다.
# 3. `.env`는 Git에 커밋하지 않는다.
#
# Docker Compose는 저장소 루트의 `.env`를 자동으로 읽고 compose.yaml의
# `${변수명:-기본값}`을 아래 값으로 덮어쓴다.
# 운영 환경에서는 모든 비밀번호를 반드시 별도의 강한 비밀번호로 변경한다.
# DB를 처음 만든 뒤 사용자·비밀번호·DB 이름을 바꿔도 기존 Docker Volume에는
# 자동 반영되지 않는다. 기존 DB를 유지해야 하면 PostgreSQL에서 직접 변경해야 한다.

# 내 Mac에서 PostgreSQL에 접속할 포트다. 컨테이너 내부 포트는 항상 5432다.
POSTGRES_PORT=35432

# PostgreSQL이 최초 실행될 때 생성할 DB 이름과 접속 계정이다.
POSTGRES_DB=purchase_research
POSTGRES_USER=purchase_research
POSTGRES_PASSWORD=purchase_research

# 내 Mac에서 Redis에 접속할 포트다. 컨테이너 내부 포트는 항상 6379다.
REDIS_PORT=36379

# Redis 접속 비밀번호다. PoC에서도 빈 비밀번호로 실행하지 않는다.
REDIS_PASSWORD=purchase_research

# 내 Mac에서 RabbitMQ 작업 통신과 관리 화면에 접속할 포트다.
# 컨테이너 내부 포트는 각각 5672와 15672다.
RABBITMQ_AMQP_PORT=35672
RABBITMQ_MANAGEMENT_PORT=35673

# RabbitMQ가 최초 실행될 때 생성할 계정과 전용 virtual host다.
RABBITMQ_USER=purchase_research
RABBITMQ_PASSWORD=purchase_research
RABBITMQ_VHOST=purchase_research

# Docker 밖에서 실행하는 Go·Python Worker가 사용할 전체 AMQP 주소다.
# 위 계정·포트·vhost를 변경하면 이 주소도 같은 값으로 변경한다.
PURCHASE_RESEARCH_RABBITMQ_URL=amqp://purchase_research:purchase_research@127.0.0.1:35672/purchase_research

# 선택 기능이다. 비워두면 Python Worker/CollectionRunner는 Redis 없이 기존처럼
# 로컬 속도 제어(prefetch, min_interval)만 사용한다. 여러 Worker instance나 process가
# 같은 판매처를 동시에 처리해 판매처 전역 초당 요청 수를 나눠 쓰고 싶을 때만 채운다.
PURCHASE_RESEARCH_REDIS_URL=
# PURCHASE_RESEARCH_RATE_LIMIT_PER_SECOND=1.0

# Go Collector가 ABC마트 검색 HTML을 rendering할 때 사용할 Chrome 실행 파일이다.
# 비워두면 macOS 기본 Google Chrome 경로와 PATH의 Chrome/Chromium을 자동으로 찾는다.
COLLECTOR_CHROME_BIN=

# Go Collector HTTP 서버의 주소와 lifecycle 제한 시간이다.
COLLECTOR_HTTP_ADDRESS=:8090
COLLECTOR_READ_TIMEOUT=5s
COLLECTOR_WRITE_TIMEOUT=90s
COLLECTOR_IDLE_TIMEOUT=60s
COLLECTOR_SHUTDOWN_TIMEOUT=10s

# 29CM 50개 상품의 상세 HTML을 1초 간격으로 검증할 수 있도록
# RabbitMQ 페이지 작업 제한 시간을 90초로 설정한다.
COLLECTOR_WORKER_TIMEOUT=90s

# Next.js server가 browser 대신 Spring Boot Product Backend를 호출할 내부 주소다.
# `NEXT_PUBLIC_` 접두사를 붙이지 않아 browser bundle에 서버 주소를 노출하지 않는다.
PRODUCT_BACKEND_BASE_URL=http://127.0.0.1:8080

# Next.js server가 Product Backend 응답을 기다리는 최대 시간이다.
PRODUCT_BACKEND_REQUEST_TIMEOUT_MS=5000

# 기본값 disabled에서는 PostgreSQL 전문 검색만 사용한다.
# 로컬 Ollama에 bge-m3:567m을 직접 준비하고 offline 품질 평가를 통과한 환경에서만
# provider를 ollama로 바꾼다. 상품 검색 문서와 질문은 이 로컬 endpoint로만 전송된다.
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_MODEL_VERSION=ollama-bge-m3-567m-q4_0
EMBEDDING_TIMEOUT_MS=3000

# Next.js server가 구매 조건 구조화에 사용할 Codex CLI 실행 파일과 제한 시간이다.
# 인증은 browser가 아니라 이 명령을 실행하는 server 계정의 Codex 로그인 정보를 사용한다.
CODEX_CLI_PATH=codex
CODEX_GATEWAY_TIMEOUT_MS=90000

# 일반 실행에서는 비워 둔다. monorepo 위치를 자동으로 찾지 못하는 배포 환경에서만 지정한다.
PURCHASE_RESEARCH_REPO_ROOT=
PURCHASE_RESEARCH_MCP_ENTRY=
