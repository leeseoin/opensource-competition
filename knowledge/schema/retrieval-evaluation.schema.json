{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purchase-research.local/knowledge/schema/retrieval-evaluation.schema.json",
  "title": "RetrievalEvaluationDataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "snapshot", "reviewStatus", "humanReviewRequired", "cases"],
  "properties": {
    "version": { "type": "string", "pattern": "^v[0-9]+$" },
    "snapshot": { "type": "string", "minLength": 1 },
    "reviewStatus": { "enum": ["DRAFT", "REVIEWED"] },
    "humanReviewRequired": { "type": "boolean" },
    "cases": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/evaluationCase" }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value"],
      "properties": {
        "field": {
          "enum": ["productType", "brand", "merchant", "priceMax", "size", "color", "stock", "usage", "reviewSignal"]
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merchant", "externalId", "relevance", "evidenceFields"],
      "properties": {
        "merchant": { "enum": ["abcmart", "29cm"] },
        "externalId": { "type": "string", "minLength": 1 },
        "relevance": { "type": "integer", "minimum": 0, "maximum": 3 },
        "evidenceFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "question", "required", "preferred", "judgments", "expectNoResults", "requiresVerification", "allowedRelaxations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+-[0-9]{3}$" },
        "type": { "enum": ["exact", "semantic", "relaxation", "no_result", "reverification"] },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "required": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "preferred": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "judgments": { "type": "array", "items": { "$ref": "#/$defs/judgment" } },
        "expectNoResults": { "type": "boolean" },
        "requiresVerification": { "type": "boolean" },
        "allowedRelaxations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
