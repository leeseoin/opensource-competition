{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purchase-research.local/knowledge/schema/wiki-page.schema.json",
  "title": "WikiPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["pageId", "version", "status", "title", "claims", "reviewedBy", "reviewedAt", "supersedes"],
  "properties": {
    "pageId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["DRAFT", "PUBLISHED", "SUPERSEDED"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "reviewedBy": { "type": ["string", "null"], "minLength": 1 },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "type": ["string", "null"] },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "subject", "relation", "object", "derived", "confidence", "sourceIds", "evidencePointers"],
        "properties": {
          "claimId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "subject": { "type": "string", "minLength": 1, "maxLength": 100 },
          "relation": { "enum": ["narrower", "synonym", "merchant_category"] },
          "object": { "type": "string", "minLength": 1, "maxLength": 100 },
          "derived": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidencePointers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
